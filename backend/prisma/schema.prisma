generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum TicketType {
  REGULAR_SINGLE
  REGULAR_DUO
  FRONT_SINGLE
  FRONT_DUO
}

enum AdminRole {
  SUPER_ADMIN
  EVENT_ADMIN
}

model Event {
  id         String      @id @default(uuid())
  name       String
  slug       String      @unique
  date       DateTime
  venue      String?
  sheetId    String?
  publicKey  String
  privateKey String
  status     EventStatus @default(DRAFT)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  tickets  Ticket[]
  scanners Scanner[]
  syncLogs SyncLog[]
  syncJobs SyncJob[]
}

model Ticket {
  id              String     @id @default(uuid())
  eventId         String
  ticketCode      String     @unique
  submittedAt     DateTime?
  name            String
  personalEmail   String
  collegeEmail    String?
  regNo           String?
  phone           String?
  batch           String?
  referral        String?
  txnId           String?
  payerName       String?
  paymentProofUrl String?
  paymentVerified Boolean    @default(false)
  ticketType      TicketType
  duoGroupId      String?
  qrData          String?
  emailSent       Boolean    @default(false)
  emailSentAt     DateTime?
  checkedIn       Boolean    @default(false)
  checkedInAt     DateTime?
  checkedInBy     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  event   Event     @relation(fields: [eventId], references: [id])
  syncLog SyncLog[]

  @@index([eventId])
  @@index([ticketCode])
  @@index([duoGroupId])
}

model Scanner {
  id         String   @id @default(uuid())
  eventId    String
  deviceName String
  deviceId   String   @unique
  apiKey     String
  lastSync   DateTime?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  event   Event     @relation(fields: [eventId], references: [id])
  syncLog SyncLog[]

  @@index([eventId])
}

model SyncLog {
  id        String   @id @default(uuid())
  ticketId  String
  scannerId String
  action    String
  timestamp DateTime
  isWinner  Boolean
  syncedAt  DateTime @default(now())

  ticket  Ticket  @relation(fields: [ticketId], references: [id])
  scanner Scanner @relation(fields: [scannerId], references: [id])

  @@index([ticketId])
  @@index([scannerId])
}

model Admin {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(EVENT_ADMIN)
  createdAt    DateTime  @default(now())
}

model SyncJob {
  id         String   @id @default(uuid())
  eventId    String
  source     String
  sheetId    String?
  status     String
  imported   Int      @default(0)
  skipped    Int      @default(0)
  errorCount Int      @default(0)
  errors     Json?
  rowCount   Int      @default(0)
  totalRows  Int      @default(0)
  truncated  Boolean  @default(false)
  startedAt  DateTime @default(now())
  finishedAt DateTime?

  event Event @relation(fields: [eventId], references: [id])

  @@index([eventId])
  @@index([startedAt])
}
